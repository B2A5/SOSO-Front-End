#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-push checks..."

# 브랜치명 컨벤션 검증
current_branch=$(git branch --show-current)
echo "🌿 Validating branch name: $current_branch"

# 허용된 브랜치 패턴: feat/*, fix/*, docs/*, refactor/*, test/*, chore/*, main, dev
if ! [[ "$current_branch" =~ ^(feat|fix|docs|refactor|test|chore|perf|ci|build)/.+ ]] && \
   ! [[ "$current_branch" =~ ^(main|dev)$ ]]; then
  echo "❌ Invalid branch name: $current_branch"
  echo ""
  echo "📝 Branch naming convention:"
  echo "  feat/feature-name      - 새로운 기능"
  echo "  fix/bug-description    - 버그 수정"
  echo "  docs/doc-update        - 문서 업데이트"
  echo "  refactor/refactor-name - 리팩토링"
  echo "  test/test-addition     - 테스트 추가"
  echo "  chore/maintenance      - 유지보수"
  echo "  perf/performance-fix   - 성능 개선"
  echo "  ci/ci-update          - CI/CD 설정"
  echo ""
  echo "📋 Examples:"
  echo "  feat/user-login"
  echo "  fix/navigation-bug"
  echo "  docs/readme-update"
  exit 1
fi

# 타입체크 실행
echo "⚡ Type checking..."
pnpm typecheck
if [ $? -ne 0 ]; then
  echo "❌ Type check failed. Push aborted."
  exit 1
fi

# 짧은 테스트 실행 (유닛 테스트만)
echo "🧪 Running unit tests..."
pnpm test
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Push aborted."
  exit 1
fi

echo "✅ All pre-push checks passed!"